# ============================================
# V4You Technologies — Environment Variables
# Copy to .env.local and fill in.
# ============================================

# --- Core (required to run at all) ---
DATABASE_URI=postgresql://user:password@host:5432/v4you
PAYLOAD_SECRET=                       # 32+ random characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Revalidation ---
REVALIDATE_SECRET=                    # shared secret for /api/revalidate

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@v4you.tech    # must be on a verified domain
LEAD_NOTIFICATION_EMAIL=              # where new leads are sent internally

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=v4you-media
R2_PUBLIC_URL=

# --- CRM (optional — sync no-ops when unset) ---
CRM_PROVIDER=                         # hubspot | zoho
CRM_API_KEY=
CRM_PORTAL_ID=

# --- Booking (optional) ---
NEXT_PUBLIC_CAL_LINK=                 # e.g. v4you/transformation-consultation

# --- Analytics (optional — track() no-ops when unset) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- WhatsApp (optional — button hidden when unset) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=          # full international format, no +

# Renders placeholder case studies so the rail can be designed before
# client-approved studies exist. Never set this in a deployment — the content
# it enables is explicitly labelled a sample, but it is still not real proof.
NEXT_PUBLIC_SAMPLE_CONTENT=0
